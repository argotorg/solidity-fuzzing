[submodule "solidity"]
	path = solidity
	url = https://github.com/argotorg/solidity.git
[submodule "evmone"]
	path = evmone
	url = https://github.com/ipsilon/evmone.git
	# Must stay on the evmone release that solidity pins (see solidity/scripts/install_evmone.ps1):
	# a mismatch means evmone's vendored evmc disagrees with solidity's on EVMC_ABI_VERSION and
	# the evmc_revision numbering, which the EVMONE_STATIC fuzz path cannot detect.
[submodule "tree-sitter-solidity"]
	path = tree-sitter-solidity
	url = https://github.com/JoranHonig/tree-sitter-solidity.git
 	ignore = untracked
[submodule "afl-ts"]
	path = afl-ts
	url = https://github.com/msooseth/afl-ts.git
 	ignore = untracked
[submodule "AFLplusplus"]
	path = AFLplusplus
	url = https://github.com/AFLplusplus/AFLplusplus.git
[submodule "tsgen"]
	path = tsgen
	url = https://github.com/jubnzv/tsgen.git
[submodule "tree-sitter"]
	path = tree-sitter
	url = https://github.com/tree-sitter/tree-sitter.git
